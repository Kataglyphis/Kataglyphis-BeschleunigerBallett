#version 460

#extension GL_EXT_ray_query : require
#extension GL_EXT_nonuniform_qualifier : enable
#extension GL_GOOGLE_include_directive : enable
#extension GL_EXT_scalar_block_layout : enable

#extension GL_EXT_shader_explicit_arithmetic_types_int64 : require
#extension GL_EXT_buffer_reference2 : require

#include "raycommon.glsl"

#include "hostDevice/host_device_shared_vars.hpp"

#include "SceneUBO.hpp"
#include "GlobalUBO.hpp"
#include "renderer/pushConstants/PushConstantPathTracing.hpp"
#include "scene/ObjMaterial.hpp"
#include "scene/Vertex.hpp"
#include "ObjectDescription.hpp"

layout(local_size_x_id = 0, local_size_y_id = 1) in;

layout (set = 0, binding = globalUBO_BINDING) uniform _GlobalUBO {
    GlobalUBO globalUBO;
};

layout (set = 0, binding = sceneUBO_BINDING) uniform _SceneUBO {
    SceneUBO sceneUBO;
};
layout(set = 0, binding = OBJECT_DESCRIPTION_BINDING, scalar) buffer ObjectDescription_ {
    ObjectDescription i[];
} object_description;

layout(set = 0, binding = SAMPLER_BINDING) uniform sampler texture_sampler[MAX_TEXTURE_COUNT];
layout(set = 0, binding = TEXTURES_BINDING) uniform texture2D tex[MAX_TEXTURE_COUNT];

layout(set = 1, binding = TLAS_BINDING) uniform accelerationStructureEXT TLAS;
layout(set = 1, binding = OUT_IMAGE_BINDING, rgba16f) uniform image2D image;
// Running-mean history in full float precision (an 8- or 16-bit mean would
// accumulate rounding and stall convergence as the per-frame delta shrinks).
layout(set = 1, binding = ACCUMULATION_IMAGE_BINDING, rgba32f) uniform image2D accumulationImage;

layout(buffer_reference, scalar) buffer Vertices {
    Vertex v[]; 
}; // Positions of an object

layout(buffer_reference, scalar) buffer Indices {
    ivec3 i[]; 
}; // Triangle indices

layout(buffer_reference, scalar) buffer MaterialIDs {
    int i[]; 
}; // per triangle material id

layout(buffer_reference, scalar) buffer Materials {
	ObjMaterial m[]; 
}; // all materials of .obj

layout(push_constant) uniform _PushConstantPathTracing {
    PushConstantPathTracing pc_ray;
};

// Steps the RNG and returns a floating-point value between 0 and 1 inclusive.
float stepAndOutputRNGFloat(inout uint rngState)
{
  // Condensed version of pcg_output_rxs_m_xs_32_32, with simple conversion to floating-point [0,1].
  rngState  = rngState * 747796405 + 1;
  uint word = ((rngState >> ((rngState >> 28) + 4)) ^ rngState) * 277803737;
  word      = (word >> 22) ^ word;
  return float(word) / 4294967295.0f;
}

struct HitInfo
{
  vec3 color;
  vec3 worldPosition;
  vec3 worldNormal;
};

HitInfo getObjectHitInfo(rayQueryEXT rayQuery)
{
    const int instanceCustomIndex = rayQueryGetIntersectionInstanceCustomIndexEXT(rayQuery, true);
    const mat4x3 objToWorld =  rayQueryGetIntersectionObjectToWorldEXT(rayQuery, true);
    const mat4x3 worldToObject = rayQueryGetIntersectionWorldToObjectEXT(rayQuery, true);

    ObjectDescription obj_res   = object_description.i[instanceCustomIndex];        // array of all object descriptions
    Indices indices             = Indices(obj_res.index_address);                   // array of all indices
    Vertices vertices           = Vertices(obj_res.vertex_address);                 // array of all vertices
    MaterialIDs materialIDs     = MaterialIDs(obj_res.material_index_address);      // array of per face material indices
    Materials materials		    = Materials(obj_res.material_address);			    // array of all materials

    HitInfo result;
    // Get the ID of the triangle
    const int primitiveID = rayQueryGetIntersectionPrimitiveIndexEXT(rayQuery, true);

    // Get the indices of the vertices of the triangle
    const ivec3 i = indices.i[primitiveID];

    // Get the vertices of the triangle
    const Vertex v0 = vertices.v[i.x];
    const Vertex v1 = vertices.v[i.y];
    const Vertex v2 = vertices.v[i.z];

    // Get the barycentric coordinates of the intersection
    vec3 barycentrics = vec3(0.0, rayQueryGetIntersectionBarycentricsEXT(rayQuery, true));
    barycentrics.x    = 1.0 - barycentrics.y - barycentrics.z;

    // Compute the coordinates of the intersection
    const vec3 objectPos = v0.position * barycentrics.x + v1.position * barycentrics.y + v2.position * barycentrics.z;
    result.worldPosition = vec3(objToWorld * vec4(objectPos, 1.0f));

    //compute normal at hit position
    const vec3 normal_hit = v0.normal * barycentrics.x + v1.normal * barycentrics.y + v2.normal * barycentrics.z;
    // Normals are DIRECTIONS: transforming with w=1 added the instance
    // translation before the normalize, which for any meaningfully translated
    // object collapses every normal toward the translation direction. The
    // correct transform is the inverse-transpose, i.e. row-multiplying the
    // world-to-object matrix (also handles non-uniform scale).
    result.worldNormal = normalize(vec3(normal_hit * worldToObject));

    vec2 texture_coordinates =  v0.texture_coords * barycentrics.x +
                                v1.texture_coords * barycentrics.y +
                                v2.texture_coords * barycentrics.z;
    
    // material id is stored per primitive
    const ObjMaterial material = materials.m[materialIDs.i[primitiveID]];
    if (material.textureID >= 0) {
        const int texture_id = clamp(material.textureID, 0, MAX_TEXTURE_COUNT - 1);
        result.color = texture(sampler2D(tex[texture_id], texture_sampler[texture_id]), texture_coordinates).xyz;
    } else {
        // Untextured material: textureID is -1, and the old clamp-to-0 made it
        // sample whichever texture happened to sit in slot 0. Use the material
        // diffuse color instead.
        result.color = material.diffuse;
    }

    return result;
}


void main() {

    const uvec2 resolution = uvec2(pc_ray.width, pc_ray.height);
    const uvec2 pixel = gl_GlobalInvocationID.xy;

    // If the pixel is outside of the image, don't do anything:
    if((pixel.x >= resolution.x) || (pixel.y >= resolution.y))
    {
    return;
    }

    // State of the random number generator. The frame index is folded in so
    // every frame draws DIFFERENT samples - without it the kernel re-rendered
    // a bit-identical noisy frame forever and accumulation would average
    // identical values.
    uint rngState = (resolution.x * pixel.y + pixel.x) + pc_ray.frame_index * 2654435769u;

    // The sum of the colors of all of the samples.
    vec3 summedPixelColor = vec3(0.0);

    // The camera position and the inverse matrices are LOOP-INVARIANT, and
    // GlobalUBO already carries inv_view/inv_projection precomputed on the
    // CPU (added for the clouds pass, whose comment calls per-pixel inverse()
    // "ruinously expensive"). This kernel was calling inverse() three times
    // PER SAMPLE - 24 full 4x4 inversions per pixel per frame - for matrices
    // that never change within the dispatch.
    const vec4 cameraOrigin = globalUBO.inv_view * vec4(0, 0, 0, 1);

    // GUI-driven (the old kernel hardcoded 8 with a stale comment claiming
    // 64). The C++ side clamps both to >= 1.
    const int NUM_SAMPLES = int(pc_ray.samples_per_pixel);
    for(int sampleIdx = 0; sampleIdx < NUM_SAMPLES; sampleIdx++)
    {
        // Re-based at every bounce below, so this is per-sample mutable state
        // seeded from the loop-invariant camera position.
        vec4 rayOrigin = cameraOrigin;
       // do not forget to invert the y-coord since we are in vulkan
        const vec2 randomPixelCenter = vec2(pixel) + vec2(stepAndOutputRNGFloat(rngState), stepAndOutputRNGFloat(rngState));
        vec2 randomPixelCenterUV = randomPixelCenter / resolution;
        vec2 randomPixelCenterCS = randomPixelCenterUV * 2.0f - 1.0f;

        vec4 target = globalUBO.inv_projection * vec4( randomPixelCenterCS.x,
                                                       randomPixelCenterCS.y,
                                                       1,
                                                       1);

        vec4 rayDirection = globalUBO.inv_view * vec4(normalize(target.xyz), 0);

        vec3 accumulatedRayColor = vec3(1.0);  // The amount of light that made it to the end of the current ray.

        // Bounce cap from the GUI (the old kernel hardcoded 8 with a stale
        // comment claiming 32).
        for(int tracedSegments = 0; tracedSegments < int(pc_ray.max_bounces); tracedSegments++)
        {
            // Russian roulette from the fourth segment on: terminate
            // low-throughput paths with probability (1 - survival) and
            // reweight the survivors by 1/survival, which keeps the estimator
            // unbiased while skipping bounces that would contribute almost
            // nothing.
            if (tracedSegments >= 3) {
                const float survival = clamp(
                  max(accumulatedRayColor.r, max(accumulatedRayColor.g, accumulatedRayColor.b)), 0.05, 0.95);
                if (stepAndOutputRNGFloat(rngState) > survival) { break; }
                accumulatedRayColor /= survival;
            }

            // Trace the ray and see if and where it intersects the scene!
            // First, initialize a ray query object:
            rayQueryEXT rayQuery;
            rayQueryInitializeEXT(rayQuery,             // Ray query
                                TLAS,                   // Top-level acceleration structure
                                gl_RayFlagsOpaqueEXT,  // Ray flags, here saying "treat all geometry as opaque"
                                0xFF,                  // 8-bit instance mask, here saying "trace against all instances"
                                rayOrigin.xyz,             // Ray origin
                                0.001,                 // Minimum t-value (matches the RT path; the 1e-4 normal offset alone under-guards self-intersection in scaled scenes)
                                rayDirection.xyz,          // Ray direction
                                10000.0);              // Maximum t-value

            // Start traversal, and loop over all ray-scene intersections. When this finishes,
            // rayQuery stores a "committed" intersection, the closest intersection (if any).
            while(rayQueryProceedEXT(rayQuery))
            {
            }

            // Get the type of committed (true) intersection - nothing, a triangle, or
            // a generated object
            if(rayQueryGetIntersectionTypeEXT(rayQuery, true) == gl_RayQueryCommittedIntersectionTriangleEXT) {
                // Ray hit a triangle
                HitInfo hitInfo = getObjectHitInfo(rayQuery);

                // Apply color absorption
                accumulatedRayColor *= hitInfo.color;

                // Flip the normal so it points against the ray direction:
                hitInfo.worldNormal = faceforward(hitInfo.worldNormal, rayDirection.xyz, hitInfo.worldNormal);

                // Start a new ray at the hit position, but offset it slightly along the normal:
                rayOrigin = vec4(hitInfo.worldPosition + 0.0001 * hitInfo.worldNormal,1.0f);

                // Next-event estimation toward the directional light: one
                // shadow ray per bounce. This is what makes the GUI light
                // exist in path tracing at all - the throughput already
                // carries the albedo product for this hit. The light is a
                // delta direction, unreachable by the diffuse bounce ray, so
                // this does not double-count with the sky term on miss.
                const vec3 light_dir = normalize(-sceneUBO.dirLight.direction.xyz);
                const float n_dot_l = dot(hitInfo.worldNormal, light_dir);
                if (n_dot_l > 0.0) {
                    rayQueryEXT shadowQuery;
                    rayQueryInitializeEXT(shadowQuery,
                                        TLAS,
                                        gl_RayFlagsOpaqueEXT | gl_RayFlagsTerminateOnFirstHitEXT,
                                        0xFF,
                                        rayOrigin.xyz,
                                        0.001,
                                        light_dir,
                                        10000.0);
                    while(rayQueryProceedEXT(shadowQuery))
                    {
                    }
                    if (rayQueryGetIntersectionTypeEXT(shadowQuery, true)
                        == gl_RayQueryCommittedIntersectionNoneEXT) {
                        summedPixelColor += accumulatedRayColor * n_dot_l
                                            * sceneUBO.dirLight.color.xyz * sceneUBO.dirLight.color.w;
                    }
                }

                // For a random diffuse bounce direction, we follow the approach of
                // Ray Tracing in One Weekend, and generate a random point on a sphere
                // of radius 1 centered at the normal. This uses the random_unit_vector
                // function from chapter 8.5:
                const float theta   = 6.2831853 * stepAndOutputRNGFloat(rngState);  // Random in [0, 2pi]
                const float u       = 2.0 * stepAndOutputRNGFloat(rngState) - 1.0;  // Random in [-1, 1]
                const float r       = sqrt(1.0 - u * u);
                rayDirection.xyz    = hitInfo.worldNormal + vec3(r * cos(theta), r * sin(theta), u);

                // RTIOW 9.4: if the random unit vector lands (numerically) on
                // -normal, the sum degenerates to a near-zero direction and the
                // next ray query gets a null direction. Fall back to the normal.
                if (dot(rayDirection.xyz, rayDirection.xyz) < 1e-8) {
                    rayDirection.xyz = hitInfo.worldNormal;
                }

            } else {

            // Ray hit the sky. The old code multiplied by NOTHING (the env
            // term was commented out), which made the sky an accidental
            // radiance-1 white furnace and the ONLY light in the scene - the
            // GUI light had no effect in PT. Now: a deliberate soft gradient
            // environment (RTIOW-style), scaled well below the directional
            // light so the NEE term above dominates the look.
            const float sky_t = 0.5 * (normalize(rayDirection.xyz).y + 1.0);
            const vec3 sky_radiance = 0.5 * mix(vec3(1.0), vec3(0.5, 0.7, 1.0), sky_t);
            summedPixelColor += accumulatedRayColor * sky_radiance;

            break;

            }
        }
    }

    const vec3 frameColor = summedPixelColor / float(NUM_SAMPLES);

    // Temporal accumulation: incremental running mean over the frames since
    // the last reset. frame_index == 0 discards the history (camera moved,
    // resize, first frame).
    vec3 accumulated = frameColor;
    if (pc_ray.frame_index > 0) {
        const vec3 history = imageLoad(accumulationImage, ivec2(pixel)).rgb;
        accumulated = history + (frameColor - history) / float(pc_ray.frame_index + 1);
    }
    imageStore(accumulationImage, ivec2(pixel), vec4(accumulated, 1.0));

    float finalAlpha = (accumulated.r + accumulated.g + accumulated.b > 0.001) ? 1.0 : 0.0;
    imageStore(image, ivec2(pixel), vec4(accumulated, finalAlpha));

}